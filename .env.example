# 复制本文件为 .env 并填入你的密钥即可启用「联网生成」模式。
# 不填则自动使用 mock 模拟模式，界面和玩法照样能跑。

# DeepSeek API key（推荐；填入后启用 DeepSeek 真实生成）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled

# Anthropic API key（可选；不填 DeepSeek 时可用 Claude 真实生成）
ANTHROPIC_API_KEY=

# 可选：第三方中转代理端点。
# - 用 Anthropic 官方 key（sk-ant- 开头）：留空即可，走官方端点。
# - 用第三方代理 key（如 sk-xxx）：必须填代理地址，否则官方端点会返回 403 Forbidden。
#   例如：ANTHROPIC_BASE_URL=https://api.openai-next.com
ANTHROPIC_BASE_URL=

# 可选：指定模型，默认 claude-sonnet-4-20250514
# 注意模型名要完整（一般带日期），如 claude-sonnet-4-20250514；写错会 404。
CLAUDE_MODEL=claude-sonnet-4-20250514
DATABASE_URL=postgres://postgres@127.0.0.1:54329/yichui
AUTH_SERVICE_URL=http://127.0.0.1:5180
